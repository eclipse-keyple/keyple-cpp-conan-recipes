+++ b/src/CMakeLists.txt
@@ -13,4 +13,9 @@
 
 # Add projects
 add_subdirectory(${CMAKE_CURRENT_SOURCE_DIR}/main)
-add_subdirectory(${CMAKE_CURRENT_SOURCE_DIR}/test)
+
+OPTION(BUILD_TESTING "Build the unit tests" ON)
+
+IF(BUILD_TESTING)
+    add_subdirectory(${CMAKE_CURRENT_SOURCE_DIR}/test)
+ENDIF()
