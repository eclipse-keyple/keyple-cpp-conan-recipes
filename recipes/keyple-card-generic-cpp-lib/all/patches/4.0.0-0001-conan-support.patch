diff --git a/CMakeLists.txt b/CMakeLists.txt
index ff07e81..91a72a5 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -30,13 +30,18 @@ SET(PACKAGE_STRING "${PACKAGE_NAME} ${PACKAGE_VERSION}")
 
 SET(CMAKE_MACOSX_RPATH 1)
 SET(CMAKE_CXX_STANDARD 11)
+SET(CMAKE_CXX_STANDARD_REQUIRED ON)
 
 # Compilers
 SET(CMAKE_C_COMPILER_WORKS 1)
 SET(CMAKE_CXX_COMPILER_WORKS 1)
 
-IF(NOT TOOLCHAIN_FILE)
-    MESSAGE(FATAL_ERROR "Toolchain file not specified")
+# Compiler warnings (compiler/OS selection itself is now handled by the
+# Conan profile passed at configure time, see profiles/).
+IF(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang|AppleClang")
+    ADD_COMPILE_OPTIONS(-Wall -Wextra -Wdeprecated -Wno-overloaded-virtual -pedantic -pedantic-errors -Werror)
+ELSEIF(MSVC)
+    ADD_COMPILE_OPTIONS(/W4 /WX /EHsc)
 ENDIF()
 
 # Set common output directory
diff --git a/src/main/CMakeLists.txt b/src/main/CMakeLists.txt
index 605b2ad..84ebcac 100644
--- a/src/main/CMakeLists.txt
+++ b/src/main/CMakeLists.txt
@@ -15,10 +15,11 @@ SET(LIBRARY_NAME keyplecardgenericcpplib)
 
 SET(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -DKEYPLECARDGENERIC_EXPORT")
 
-INCLUDE("CMakeLists.txt.keypop-card")
-INCLUDE("CMakeLists.txt.keypop-genericcard")
-INCLUDE("CMakeLists.txt.keyple-service-resource")
-INCLUDE("CMakeLists.txt.keyple-util")
+# Dependencies are supplied by Conan (requires) via CMakeDeps
+FIND_PACKAGE(keypop-card-cpp-api REQUIRED CONFIG)
+FIND_PACKAGE(keypop-genericcard-cpp-api REQUIRED CONFIG)
+FIND_PACKAGE(keyple-service-resource-cpp-lib REQUIRED CONFIG)
+FIND_PACKAGE(keyple-util-cpp-lib REQUIRED CONFIG)
 
 ADD_LIBRARY(
 
@@ -66,3 +67,19 @@ ADD_LIBRARY(
 
     ${LIBRARY_NAME}
 )
+
+INSTALL(
+
+    TARGETS ${LIBRARY_NAME}
+
+    LIBRARY DESTINATION lib
+    ARCHIVE DESTINATION lib
+    RUNTIME DESTINATION bin
+)
+
+INSTALL(
+
+    DIRECTORY ${PROJECT_SOURCE_DIR}/include/
+
+    DESTINATION include
+)
